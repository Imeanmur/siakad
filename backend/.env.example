# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit file .env.

PORT=3000

# Database MySQL (import siakad.sql terlebih dahulu)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=siakad
# Isi "true" jika penyedia database mewajibkan koneksi SSL (mis. Aiven, TiDB Cloud)
DB_SSL=false

# Rahasia untuk menandatangani token login. Buat string acak panjang, contoh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Asal (origin) front-end yang diizinkan memanggil API, pisahkan dengan koma.
# Contoh: https://namasitus.infinityfreeapp.com,http://localhost:5500
FRONTEND_ORIGIN=http://localhost:5500,http://127.0.0.1:5500

# Pengaturan SMTP Email untuk pengiriman OTP (mis. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SIAKAD
SMTP_FROM_EMAIL=

